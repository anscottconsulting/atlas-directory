# Caddyfile for the Atlas Directory deployment.
#
# Default: HTTP only on port 80, suitable for a raw EC2 IP.
# To enable HTTPS with automatic Let's Encrypt, change ":80" below to your
# domain name (e.g. "rce.example.com") and make sure ports 80 + 443 are open
# in the security group with DNS pointing at the box.

your-domain.example.com {
	encode gzip

	# Basic auth on the API paths: FHIR and the NPPES proxy. Generate a bcrypt hash with:
	#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
	# Then paste the hash below (it starts with $2a$ or $2b$).
	@api path /fhir/* /nppes/*
	basicauth @api {
		admin $2a$14$REPLACE_ME_WITH_A_REAL_BCRYPT_HASH
	}

	handle /fhir/* {
		reverse_proxy hapi:8080
	}

	# NPPES NPI Registry, for Level 2 NPI lookups. The registry sends no CORS
	# headers, so the browser calls it through here. Kept behind basic auth so
	# the box isn't an open proxy.
	handle_path /nppes/* {
		reverse_proxy https://npiregistry.cms.hhs.gov {
			header_up Host {upstream_hostport}
		}
	}

	# React SPA — serve static files, fall back to index.html for client routing.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	# Log access (rotated automatically by Caddy).
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
